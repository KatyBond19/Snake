{
  "name": "@snake/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "npm run build -w @snake/shared-types",
    "dev": "node --watch src/index.ts",
    "prebuild": "npm run build -w @snake/shared-types",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build -w @snake/shared-types",
    "start": "node dist/index.js",
    "pretest": "npm run build -w @snake/shared-types",
    "test": "vitest run src",
    "pretest:coverage": "npm run build -w @snake/shared-types",
    "test:coverage": "vitest run src --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@snake/shared-types": "*",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
